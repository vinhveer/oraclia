# Edge function secrets. Never committed, never sent to the browser.
# Leave LLM_API_KEY empty to run the agent in demo mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# Model cho việc nền (tiêu đề, phản tư). Trống = dùng LLM_MODEL.
LLM_MODEL_FAST=
# Trống = 0.75. Đặt "none" cho model reasoning chỉ nhận temperature mặc định.
LLM_TEMPERATURE=
# Trần token đầu ra mỗi lượt. Trống = để provider quyết.
LLM_MAX_TOKENS=
# low | medium | high cho model có reasoning. Trống = không gửi.
LLM_REASONING_EFFORT=
AGENT_RUNS_PER_HOUR=60
ALLOWED_ORIGINS=https://nguyenquangvinh.id.vn,http://localhost:5173
