{
  "name": "tarot-reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > supabase/client/database.types.ts",
    "iching:refresh-lines": "node scripts/fetch-iching-lines.mjs",
    "check:readings": "node scripts/verify-reading-data.mjs",
    "functions:serve": "supabase functions serve --env-file supabase/.env.local",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "test:functions": "deno test --config supabase/functions/deno.json --no-lock supabase/functions",
    "eval:readings": "node scripts/eval/readings.mjs",
    "eval:retrieval": "node scripts/eval/retrieval.mjs",
    "kb:sync": "node scripts/kb/sync.mjs",
    "kb:review": "node scripts/kb/review.mjs",
    "kb:generate": "node scripts/kb/generate.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "supabase": "^2.114.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
