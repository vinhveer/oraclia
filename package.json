{
  "name": "tarot-reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > supabase/client/database.generated.ts",
    "iching:refresh-lines": "node scripts/fetch-iching-lines.mjs",
    "check:readings": "node scripts/verify-reading-data.mjs",
    "functions:serve": "supabase functions serve --env-file supabase/.env.local",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "test:functions": "deno test --config supabase/functions/deno.json --no-lock supabase/functions",
    "eval:readings": "node scripts/eval/readings.mjs",
    "eval:retrieval": "node scripts/eval/retrieval.mjs",
    "eval:pairwise": "node scripts/eval/pairwise.mjs",
    "eval:feedback": "node scripts/eval/from-feedback.mjs",
    "kb:sync": "node scripts/kb/sync.mjs",
    "kb:review": "node scripts/kb/review.mjs",
    "kb:generate": "node scripts/kb/generate.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.31",
    "@assistant-ui/react-markdown": "^0.14.24",
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/modals": "^9.7.3",
    "@mantine/notifications": "^9.7.3",
    "@supabase/supabase-js": "^2.58.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.31",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "supabase": "^2.114.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
